# Locally every variable is optional: docker compose up works without a .env file.
# The production stack (docker-compose.prod.yml) needs the four values in the first block.

# Production, required. DB_PASSWORD: letters and digits only. PUBLIC_BASE_URL: http://<server-ip>
DB_PASSWORD=
OPERATOR_USER=
OPERATOR_PASSWORD=
PUBLIC_BASE_URL=

# LLM. An empty key is keyless mode: a real request, a static reply after the delay.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_RATE_LIMIT_PER_MINUTE=55
LLM_DAILY_CALL_CAP=500
LLM_REQUEST_TIMEOUT_S=45
LLM_CONCURRENCY=20
KEYLESS_DELAY_MIN_S=5
KEYLESS_DELAY_MAX_S=30

# Knowledge base
KB_MIN_SCORE=0.4

# Sending replies. REPLY_URL_ALLOWED_HOSTS: comma-separated hosts that may resolve to a
# private address (locally the default is mock-helpdesk, in production it is empty).
SEND_CONCURRENCY=10
SEND_RETRY_AMBIGUOUS=false
REPLY_URL_ALLOWED_HOSTS=

# Local stack only
APP_ENV=local
DB_HOST_PORT=5434

# Local mock helpdesk (chaos rates are fractions of requests)
FAIL_5XX_RATE=0
TIMEOUT_RATE=0
HANG_AFTER_STORE_RATE=0
HONOR_IDEMPOTENCY_KEY=true
HANG_SECONDS=60
SEED=

# Running the backend on your machine: put these in backend/.env, not here
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5434/helpdesk
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5434/helpdesk_test
# KB_CONTENT_DIR=content/knowledge_base
