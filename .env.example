# Every variable is optional: docker compose up works without any .env file.

# Read by docker compose from a .env file next to docker-compose.yml.
APP_ENV=local
DB_HOST_PORT=5434

# Read by the backend only when you run it on your machine (put it in backend/.env).
# Inside compose the database host is "db"; on the host use the published port.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5434/helpdesk
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5434/helpdesk_test
# KB_CONTENT_DIR=content/knowledge_base
# KB_MIN_SCORE=0.4

# LLM gateway. An empty key means keyless mode: a real request is sent, its answer is
# ignored and a static reply follows after KEYLESS_DELAY_MIN_S..KEYLESS_DELAY_MAX_S.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5
# LLM_RATE_LIMIT_PER_MINUTE=55
# LLM_DAILY_CALL_CAP=500
# LLM_REQUEST_TIMEOUT_S=45
# KEYLESS_DELAY_MIN_S=5
# KEYLESS_DELAY_MAX_S=30
